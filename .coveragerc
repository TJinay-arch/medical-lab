# .coveragerc
[run]
source = .
omit =
    */migrations/*
    */venv/*
    */__pycache__/*
    */tests/*
    manage.py
    config/asgi.py
    config/wsgi.py
    config/settings.py

[report]
exclude_lines =
    pragma: no cover
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if settings.DEBUG